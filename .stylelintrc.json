{
  "extends": ["stylelint-config-standard-scss", "stylelint-config-rational-order"],
  "overrides": [
    {
      "files": [
        "*.js"
      ],
      "customSyntax": "postcss-lit"
    },
    {
      "files": [
        "src/assets/presets/*.scss"
      ],
      "rules": {
        "nesting-selector-no-missing-scoping-root": null
      }
    }
  ]
}
